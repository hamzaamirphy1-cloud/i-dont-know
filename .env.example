# Local PostgreSQL only. Use separate credentials in any deployed environment.
DATABASE_URL=postgresql://vibe96:vibe96_local_only@127.0.0.1:5432/vibe96
APP_URL=http://localhost:3000
# Set COOKIE_SECURE=true when serving over HTTPS (required for public deployments).
COOKIE_SECURE=false
# Optional. Without these, checkout explicitly reports Not connected.
# Only Stripe TEST MODE keys are supported by this MVP.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Private directory, outside public/. Back up with PostgreSQL.
ARTIFACT_DIR=./data/artifacts
# Dev seed users only. Never run the demo seed against a production database.
SEED_DEMO=true
SEED_PASSWORD=Vibe96-demo-2026!
# Vercel only: connect a PRIVATE Blob store in the Vercel dashboard.
# Leave empty locally to keep the existing private filesystem workflow.
BLOB_READ_WRITE_TOKEN=
# Set to vercel-blob to opt into Blob storage outside Vercel as well.
ARTIFACT_STORAGE=
# Hosted builds migrate the connected database only when explicitly opted in.
PREPARE_DATABASE_ON_BUILD=false
# On Vercel, APP_URL can be omitted; provider-owned production/preview URLs are used.
# Public seed deployments must use a strong private SEED_PASSWORD (16+ characters),
# never the local example password above. Store it in Vercel settings, not Git.
